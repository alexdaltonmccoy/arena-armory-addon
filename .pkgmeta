# BigWigs packager config (https://github.com/BigWigsMods/packager).
# The addon lives in the ArenaArmory/ subfolder; everything else in the repo
# (marketing assets, scripts) is excluded from the shipped zip.

package-as: ArenaArmory

move-folders:
  ArenaArmory/ArenaArmory: ArenaArmory

ignore:
  - marketing
  - scripts
  - dist
  - README.md
  - DEVELOPMENT.md
  - CHANGELOG.md

enable-toc-creation: no

# Without this, the packager auto-generates the CurseForge/Wago changelog
# from raw git commit messages since the last tag - which leaks internal
# implementation detail (file names, root-cause writeups, co-author trailers)
# to players. Point it at a curated, player-facing file instead.
manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown
